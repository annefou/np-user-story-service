{
  "name": "@nanopub/sign",
  "type": "module",
  "description": "JavaScript bindings for the Nanopub rust toolkit",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vemonet/nanopub-rs.git",
    "directory": "js"
  },
  "files": [
    "*.{js,wasm,d.ts}"
  ],
  "main": "node.js",
  "homepage": "https://github.com/vemonet/nanopub-rs/tree/main/js",
  "types": "bundler.d.ts",
  "sideEffects": [
    "./bundler.js",
    "./snippets/*"
  ],
  "keywords": [
    "nanopublications",
    "rdf",
    "linked-data",
    "semantic-web"
  ],
  "module": "bundler.js",
  "browser": "web.js",
  "exports": {
    ".": {
      "browser": {
        "import": "./web.js",
        "require": "./web.js"
      },
      "import": "./bundler.js",
      "require": "./node.js",
      "default": "./node.js"
    }
  },
  "unpkg": "web.js",
  "bugs": {
    "url": "https://github.com/vemonet/nanopub-rs/issues"
  }
}